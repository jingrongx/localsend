# Copy this file to app/android/key.properties (gitignored) for local release builds.
# CI instead decodes the same keys from the ANDROID_KEY_PROPERTIES secret.
#
# storeFile may be an absolute path or one relative to app/android/.
# Use forward slashes - backslashes are escape characters in .properties files.
storeFile=/absolute/path/to/your/android-keystore.jks
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=YOUR_KEY_ALIAS
keyPassword=YOUR_KEY_PASSWORD
